generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supavisor, transaction mode, port 6543) — used
  // by the running app. Transaction-mode pooling lets many short-lived
  // serverless function invocations share a small number of real
  // Postgres connections instead of each opening its own, which is
  // what was exhausting Supabase's connection cap and causing
  // intermittent login failures.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection, port 5432 — used ONLY for schema
  // commands (`prisma db push`, `prisma migrate ...`). Those commands
  // need a stable, non-pooled connection; running them through the
  // same session-mode pooler the app uses is what caused the
  // "MaxClientsInSessionMode" error.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum LedgerType {
  SIGNUP_BONUS
  DEPOSIT
  PREDICTION_STAKE
  PREDICTION_REWARD
  REDEMPTION
  ADMIN_ADJUSTMENT
  REFUND
  STAKE_LOCK
  STAKE_RELEASE
  REFERRAL_BONUS
  SPIN_COST
  SPIN_PAYOUT
  NUMBER_PICK_STAKE
  NUMBER_PICK_PAYOUT
}

enum LedgerStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum MatchStatus {
  UPCOMING
  LOCKED
  SETTLED
  CANCELLED
}

enum PredictionPick {
  HOME
  DRAW
  AWAY
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

enum StakeDuration {
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum StakeStatus {
  ACTIVE
  MATURED
  RELEASED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Signup-bonus anti-abuse: bonus-derived credits are locked from
  // withdrawal until the user has staked (wagered) this much in total.
  bonusWageringRequired Int @default(0)
  bonusWageringProgress Int @default(0)

  // Permanent withdrawal floor: the free bonus can NEVER be withdrawn,
  // even after the wagering requirement is met — only balance ABOVE
  // this floor is ever eligible to leave as USDT. Set once, at the
  // exact amount actually issued, so later config changes never
  // retroactively affect an existing user's floor.
  bonusFloor Int @default(0)

  signupBonusIssued Boolean @default(false)

  // Email verification (Option B: NextAuth stays, verification layer
  // added on top via SendGrid). Login is blocked until verified.
  emailVerified          Boolean   @default(false)
  verificationToken      String?   @unique
  verificationTokenExpiry DateTime?

  // Rate-limits the resend-verification endpoint to one email per
  // hour per account, independent of the token's own 24h expiry.
  verificationEmailLastSentAt DateTime?

  // Referrals: PlatformConfig.referralBonusCredits (default 500 NGC)
  // is paid to the referrer once the referred user verifies their
  // email — see app/api/auth/verify/route.ts. referralCode is this
  // user's own shareable code; referredByUserId links back to
  // whoever referred them.
  referralCode      String  @unique
  referredByUserId  String?
  referredBy        User?   @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals         User[]  @relation("Referrals")
  referralBonusPaid Boolean @default(false) // guards against double-crediting the referrer

  // One-wallet-per-account: enforced at first withdrawal, not at
  // signup, so the free bonus stays frictionless to claim. Once set,
  // a user can only ever withdraw to this exact wallet, and the DB
  // unique constraint means no other account can ever link the same
  // wallet — this is the core anti-multi-accounting control.
  walletAddress String? @unique

  ledgerEntries   LedgerEntry[]
  deposits        DepositRequest[]
  withdrawals     WithdrawalRequest[]
  predictions     Prediction[]
  predictionSlips PredictionSlip[]
  stakes          Stake[]
  spinPlays       SpinPlay[]
  numberPickEntries NumberPickEntry[]
  // Earned by landing the Bonus segment on Spin the Wheel. Tracked
  // server-side (never trust a client's claim of "this is a free
  // spin") — consumed one at a time by playSpin() in lib/games.ts.
  freeSpinsAvailable Int @default(0)
}

// Source of truth for balances. Never store/edit a raw balance column —
// always derive it by summing CONFIRMED entries for a user.
model LedgerEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  type        LedgerType
  amount      Int          // positive = credit, negative = debit (in NGOAT Credits)
  status      LedgerStatus @default(CONFIRMED)
  reference   String       @unique
  description String?
  createdAt   DateTime     @default(now())

  @@index([userId])
}

model DepositRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  usdtAmount       Float
  network          String
  txHash           String        @unique // DB-level guard against ever crediting the same on-chain tx twice
  payoutWalletUsed String
  creditsToIssue   Int
  status           DepositStatus @default(PENDING)
  adminNote        String?
  createdAt        DateTime      @default(now())
  reviewedAt       DateTime?

  // Set when this deposit came through the on-chain wallet-connect flow
  // (auto-verified) rather than the manual tx-hash submission form.
  autoVerified Boolean @default(false)
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  usdtAmount    Float
  network       String
  walletAddress String
  status        WithdrawalStatus @default(PENDING)
  payoutTxHash  String?
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
}

model Match {
  id                 String      @id @default(cuid())
  homeTeam           String
  awayTeam           String
  competition        String?
  kickoff            DateTime
  predictionDeadline DateTime
  entryCredits       Int         @default(1000)
  rewardCredits      Int         @default(1800)
  status             MatchStatus @default(UPCOMING)
  finalHomeScore     Int?
  finalAwayScore     Int?
  createdAt          DateTime    @default(now())

  externalId  String? @unique
  autoSettled Boolean @default(false)

  predictions Prediction[]
}

// One leg of an accumulator slip. Every prediction now belongs to a
// PredictionSlip — there is no more single-match, straight-bet flow.
model Prediction {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  matchId   String
  match     Match            @relation(fields: [matchId], references: [id])
  slipId    String
  slip      PredictionSlip   @relation(fields: [slipId], references: [id])
  pick      PredictionPick
  stake     Int              // informational, mirrors slip.stake
  status    PredictionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([userId, matchId]) // can't pick the same match twice, ever
}

// An accumulator slip: minimum 3 matches, one stake for the whole slip,
// ALL legs must win for it to pay out. Reward is ADDITIVE per leg
// (stake x (1 + legCount x rewardMultiplier)) — each correct leg adds
// a flat bonus on top of the stake rather than compounding it, so
// growth stays linear even on long slips. See lib/settlement.ts.
model PredictionSlip {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  stake     Int
  status    PredictionStatus @default(PENDING)
  reward    Int? // set once settled, for the record
  createdAt DateTime         @default(now())

  legs Prediction[]
}

// NGC staking: lock NGC for a fixed term, grows 0.1%/day, released in
// full (principal + growth) at maturity. No early withdrawal in this
// version — locked funds stay locked until the term ends.
model Stake {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  principal     Int
  duration      StakeDuration
  dailyRatePct  Float // e.g. 0.1 = 0.1%/day, snapshot at stake time
  status        StakeStatus   @default(ACTIVE)
  startedAt     DateTime      @default(now())
  maturesAt     DateTime
  releasedAt    DateTime?
  releaseAmount Int? // principal + accrued growth, set at release
}

model PlatformConfig {
  id                String  @id @default("singleton")
  usdtToCreditsRate Int     @default(2000) // 1 USDT = this many NGC
  depositWallet     String?
  depositNetwork    String?
  minDeposit        Float   @default(5)
  maxDeposit        Float   @default(1000)
  minRedemption     Int     @default(1000)
  maxRedemption     Int     @default(1000000)

  signupBonusCredits      Int   @default(20000)
  bonusWageringMultiplier Int   @default(3)
  minBetCredits           Int   @default(5000)
  // Despite the name (kept as-is to avoid a migration), this is an
  // ADDITIVE per-leg bonus rate, not an exponential multiplier — see
  // lib/settlement.ts. 0.8 = each correctly predicted leg adds +80%
  // of the stake to the payout (linear growth, not compounding).
  rewardMultiplier     Float @default(0.8)
  referralBonusCredits Int   @default(500)

  // Accumulator predictions: every slip must have at least this many legs.
  minSlipLegs Int @default(5)

  // NGC staking
  stakingMinCredits Int   @default(40000)
  stakingDailyRatePct Float @default(0.1) // percent, e.g. 0.1 = 0.1%/day

  // Daily withdrawal limits, in USDT
  minWithdrawalUsdt    Float @default(5)
  maxDailyWithdrawalUsdt Float @default(100)

  // Master switch: while false, /api/withdrawals rejects every new
  // request outright (existing PENDING/PAID/REJECTED records are
  // untouched — this only blocks new submissions). Meant to be
  // flipped on from the admin Settings tab once the project launches,
  // no redeploy needed.
  withdrawalsEnabled Boolean @default(false)

  // Solana on-chain deposit config (wallet-connect flow)
  solanaUsdtMint    String? // USDT SPL-token mint address on Solana
  solanaRpcEndpoint String? // e.g. an Alchemy/Helius RPC URL

  // Comma-separated extra disposable-email domains to block at
  // registration, on top of the built-in list in lib/security.ts.
  // Lets new throwaway-email services get blocked from the admin
  // Settings tab the moment they're spotted, no redeploy needed.
  blockedEmailDomains String?

  // NGOAT Spin the Wheel and NGOAT Number Pick. Both are only reachable
  // by direct URL for now (/spinthewheel, /numberpick) — no nav links,
  // no landing-page status change, no buttons on the predict page —
  // until they're ready for a public launch. gamesEnabled is a single
  // kill switch for both together; the per-game switches underneath
  // let either be pulled independently without touching the other.
  gamesEnabled      Boolean @default(true)
  spinEnabled       Boolean @default(true)
  numberPickEnabled Boolean @default(true)

  // Spin: fixed cost per spin. Segment odds/payouts live in
  // lib/games.ts (not admin-editable yet — see comment there).
  spinCostNgc Int @default(1000)

  // Number Pick: one draw per week, one number per person, minimum
  // stake, and the same additive-per-leg payout mechanic as football
  // predictions — but with its OWN multiplier, kept independent so
  // tuning football's rate never silently changes this game too.
  // (19 = a correct pick pays stake + 19x stake = 20x total.)
  numberPickMinStake      Int @default(10000)
  numberPickRangeMax      Int @default(50)
  numberPickRewardMultiplier Float @default(1.8)
}

// One row per spin. Kept even after the NGC/free-respin outcome is
// settled, as the permanent record of what happened and why.
model SpinPlay {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  cost         Int // 0 if this spin was itself a free bonus respin
  segmentLabel String // e.g. "500", "0", "BONUS" — matches the wheel segment landed on
  payout       Int      @default(0) // NGC credited; 0 for the 0-segment and the bonus segment
  isBonusSpin  Boolean  @default(false) // true if this spin itself came from landing on Bonus last time
  createdAt    DateTime @default(now())

  @@index([userId])
}

// One row per person per weekly draw. The draw itself (winning number,
// settlement) is tracked on NumberPickDraw; this is just "who staked
// what on which number, in which week."
model NumberPickEntry {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  drawId    String
  draw      NumberPickDraw    @relation(fields: [drawId], references: [id])
  number    Int
  stake     Int
  status    PredictionStatus  @default(PENDING)
  payout    Int               @default(0)
  createdAt DateTime          @default(now())

  // One entry per person per draw — enforced at the DB level, not
  // just in application code.
  @@unique([userId, drawId])
  @@index([drawId])
}

model NumberPickDraw {
  id            String            @id @default(cuid())
  weekStart     DateTime          @unique // the Monday (or chosen cutoff) this draw covers
  drawAt        DateTime // when the winning number is/was revealed
  winningNumber Int?
  settled       Boolean           @default(false)
  entries       NumberPickEntry[]
  createdAt     DateTime          @default(now())
}

// One row per registration attempt (successful or rejected), used to
// rate-limit /api/auth/register by IP. Deliberately just an IP + a
// timestamp — nothing else needs to be stored here. Rows older than
// the rate-limit window are pruned opportunistically every time a
// check runs, so this table never grows unbounded.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}