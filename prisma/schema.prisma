generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String              @id @default(cuid())
  username                String              @unique
  email                   String              @unique
  passwordHash            String
  role                    Role                @default(USER)
  suspended               Boolean             @default(false)
  createdAt               DateTime            @default(now())
  bonusWageringRequired   Int                 @default(0)
  bonusWageringProgress   Int                 @default(0)
  signupBonusIssued       Boolean             @default(false)
  bonusFloor              Int                 @default(0)
  emailVerified           Boolean             @default(false)
  referralBonusPaid       Boolean             @default(false)
  referralCode            String              @unique
  referredByUserId        String?
  verificationToken       String?             @unique
  verificationTokenExpiry DateTime?
  walletAddress           String?             @unique
  deposits                DepositRequest[]
  ledgerEntries           LedgerEntry[]
  predictions             Prediction[]
  predictionSlips         PredictionSlip[]
  stakes                  Stake[]
  referredBy              User?               @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals               User[]              @relation("Referrals")
  withdrawals             WithdrawalRequest[]
}

model LedgerEntry {
  id          String       @id @default(cuid())
  userId      String
  type        LedgerType
  amount      Int
  status      LedgerStatus @default(CONFIRMED)
  reference   String       @unique
  description String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model DepositRequest {
  id               String        @id @default(cuid())
  userId           String
  usdtAmount       Float
  network          String
  txHash           String        @unique
  payoutWalletUsed String
  creditsToIssue   Int
  status           DepositStatus @default(PENDING)
  adminNote        String?
  createdAt        DateTime      @default(now())
  reviewedAt       DateTime?
  autoVerified     Boolean       @default(false)
  user             User          @relation(fields: [userId], references: [id])
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  usdtAmount    Float
  network       String
  walletAddress String
  status        WithdrawalStatus @default(PENDING)
  payoutTxHash  String?
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  user          User             @relation(fields: [userId], references: [id])
}

model Match {
  id                 String       @id @default(cuid())
  homeTeam           String
  awayTeam           String
  competition        String?
  kickoff            DateTime
  predictionDeadline DateTime
  entryCredits       Int          @default(1000)
  rewardCredits      Int          @default(1800)
  status             MatchStatus  @default(UPCOMING)
  finalHomeScore     Int?
  finalAwayScore     Int?
  createdAt          DateTime     @default(now())
  autoSettled        Boolean      @default(false)
  externalId         String?      @unique
  predictions        Prediction[]
}

model Prediction {
  id        String           @id @default(cuid())
  userId    String
  matchId   String
  pick      PredictionPick
  stake     Int
  status    PredictionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  slipId    String
  match     Match            @relation(fields: [matchId], references: [id])
  slip      PredictionSlip   @relation(fields: [slipId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([userId, matchId])
}

model PredictionSlip {
  id        String           @id @default(cuid())
  userId    String
  stake     Int
  status    PredictionStatus @default(PENDING)
  reward    Int?
  createdAt DateTime         @default(now())
  legs      Prediction[]
  user      User             @relation(fields: [userId], references: [id])
}

model Stake {
  id            String        @id @default(cuid())
  userId        String
  principal     Int
  duration      StakeDuration
  dailyRatePct  Float
  status        StakeStatus   @default(ACTIVE)
  startedAt     DateTime      @default(now())
  maturesAt     DateTime
  releasedAt    DateTime?
  releaseAmount Int?
  user          User          @relation(fields: [userId], references: [id])
}

model PlatformConfig {
  id                      String  @id @default("singleton")
  usdtToCreditsRate       Int     @default(2000)
  depositWallet           String?
  depositNetwork          String?
  minDeposit              Float   @default(5)
  maxDeposit              Float   @default(1000)
  minRedemption           Int     @default(1000)
  maxRedemption           Int     @default(1000000)
  signupBonusCredits      Int     @default(20000)
  bonusWageringMultiplier Int     @default(3)
  minBetCredits           Int     @default(5000)
  rewardMultiplier        Float   @default(1.8)
  maxDailyWithdrawalUsdt  Float   @default(100)
  minSlipLegs             Int     @default(3)
  minWithdrawalUsdt       Float   @default(5)
  solanaRpcEndpoint       String?
  solanaUsdtMint          String?
  stakingDailyRatePct     Float   @default(0.1)
  stakingMinCredits       Int     @default(40000)
  referralBonusCredits    Int     @default(2000)
}

enum Role {
  USER
  ADMIN
}

enum LedgerType {
  SIGNUP_BONUS
  DEPOSIT
  PREDICTION_STAKE
  PREDICTION_REWARD
  REDEMPTION
  ADMIN_ADJUSTMENT
  REFUND
  STAKE_LOCK
  STAKE_RELEASE
  REFERRAL_BONUS
}

enum LedgerStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum MatchStatus {
  UPCOMING
  LOCKED
  SETTLED
  CANCELLED
}

enum PredictionPick {
  HOME
  DRAW
  AWAY
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

enum StakeDuration {
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum StakeStatus {
  ACTIVE
  MATURED
  RELEASED
}
